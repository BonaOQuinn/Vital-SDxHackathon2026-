# Copy to .env.local for local dev. Never commit real keys.
# On Vercel, set these in Project Settings > Environment Variables.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional: override the fast Claude model used by /api/turn
CLAUDE_MODEL=claude-haiku-5-5
# Supabase (project ref yxxrakeajzaossuitstf). Run `vercel env pull .env.local` to get real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ElevenLabs voice loop (optional overrides). Run `npm run voices:design` to generate voices.
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_ES=
# Daytona sandbox for backend tests (`npm run sandbox`). Local only, never needed on Vercel.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
